# ===== LLM 配置 =====
LLM_API_KEY=your-llm-api-key
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== 企查查预警通 API =====
QICHACHA_API_KEY=your-qichacha-api-key
QICHACHA_BASE_URL=https://api.qichacha.com

# ===== Neo4j 图数据库 =====
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ===== 向量库 =====
VECTOR_BACKEND=chroma
CHROMA_PATH=./.chroma
# MILVUS_URI=http://localhost:19530

# ===== 数据源策略（mock | real）=====
DATA_SOURCE=mock

# ===== 各 Agent 服务地址 =====
AGENT_COMPANY_URL=http://localhost:3001
AGENT_GRAPH_URL=http://localhost:3002
AGENT_BUSINESS_URL=http://localhost:3003
